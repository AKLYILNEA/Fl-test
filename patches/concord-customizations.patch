+
+    pub struct TrafficStatsQuery {
+        pub start: String,
+        pub end: String,
+        #[serde(default)]
+        pub top: usize,
+    }
+
+    pub struct IpAddress {
+        pub ip: String,
+    }
+
+    pub struct IpCacheGet {
+        pub ip: String,
+        #[serde(default)]
+        pub source: Option<String>,
+    }
+
+    pub struct IpCacheSet {
+        pub ip: String,
+        #[serde(default)]
+        pub source: Option<String>,
+        pub data: Json,
+    }
+}
