+#[cfg(test)]
+mod tests {
+    use super::*;
+    use time::macros::datetime;
+
+    #[test]
+    fn sleep_is_counted_once_and_split_at_local_midnight() {
+        let mut stats = TrafficRecorder::default();
+        stats.options.enable = true;
+        stats.options.tz_offset = 480;
+        stats.since = Some(datetime!(2026-11-17 15:00 UTC));
+        let wake = datetime!(2026-11-17 20:00 UTC);
+        stats.settle(wake);
+        stats.settle(wake);
+        stats.settle(datetime!(2026-11-17 19:00 UTC));
+        stats.settle(datetime!(2026-11-17 21:00 UTC));
+        assert_eq!(stats.days["2026-11-17"].running_ms, 3_600_000);
+        assert_eq!(stats.days["2026-11-18"].running_ms, 18_000_000);
+    }
+}
