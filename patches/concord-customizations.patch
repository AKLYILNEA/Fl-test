diff --git a/crates/tunnel/src/traffic_stats.rs b/crates/tunnel/src/traffic_stats.rs
new file mode 100644
index 0000000..766c758
--- /dev/null
+++ b/crates/tunnel/src/traffic_stats.rs
@@ -0,0 +1,530 @@
+use std::collections::{BTreeMap, HashMap};
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use concord_common::ConnRecord;
+use concord_platform::HomeDir;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use time::{Date, OffsetDateTime, UtcOffset, macros::format_description};
+
+const FILE: &str = "traffic_stats_rust.json";
+const DATE: &[time::format_description::FormatItem<'static>] =
+    format_description!("[year]-[month]-[day]");
+const DIMENSIONS: [&str; 5] = ["hosts", "processes", "nodes", "profiles", "rules"];
+
+#[derive(Clone, Copy, Default, Serialize, Deserialize)]
+struct Bytes {
+    up: u64,
+    down: u64,
+}
+
+impl Bytes {
+    fn add(&mut self, other: Self) {
+        self.up = self.up.saturating_add(other.up);
+        self.down = self.down.saturating_add(other.down);
+    }
+
+    fn total(self) -> u64 {
+        self.up.saturating_add(self.down)
+    }
+
+    fn read(record: &ConnRecord) -> Self {
+        Self {
+            up: record.upload.load(Ordering::Relaxed),
+            down: record.download.load(Ordering::Relaxed),
+        }
+    }
+
+    fn since(self, previous: Self) -> Self {
+        Self {
+            up: self.up.saturating_sub(previous.up),
+            down: self.down.saturating_sub(previous.down),
+        }
+    }
+}
+
+#[derive(Clone, Default, Serialize, Deserialize)]
+struct Item {
+    #[serde(flatten)]
+    bytes: Bytes,
+    hits: u64,
+    path: String,
+    subs: BTreeMap<String, Bytes>,
+}
+
+impl Item {
+    fn merge(&mut self, other: &Self) {
+        self.bytes.add(other.bytes);
+        self.hits += other.hits;
+        if !other.path.is_empty() {
+            self.path.clone_from(&other.path);
+        }
+        for (name, bytes) in &other.subs {
+            self.subs.entry(name.clone()).or_default().add(*bytes);
+        }
+    }
+
+    fn to_json(&self, name: &str) -> Value {
+        let mut subs: Vec<_> = self.subs.iter().collect();
+        subs.sort_unstable_by_key(|(name, bytes)| (std::cmp::Reverse(bytes.total()), *name));
+        let subs: Vec<_> = subs
+            .into_iter()
+            .take(20)
+            .map(|(name, bytes)| json!({"name":name, "up":bytes.up, "down":bytes.down}))
+            .collect();
+        json!({"name":name, "up":self.bytes.up, "down":self.bytes.down,
+            "hits":self.hits, "path":self.path, "subs":subs})
+    }
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct Day {
+    running_ms: u64,
+    #[serde(default)]
+    rule_hits: u64,
+    total: Bytes,
+    proxy: Bytes,
+    hours: [Bytes; 24],
+    detail: [BTreeMap<String, Item>; DIMENSIONS.len()],
+}
+
+#[derive(Clone, Debug)]
+pub struct StatsOptions {
+    pub enable: bool,
+    pub detail: bool,
+    pub retention_days: u32,
+    pub tz_offset: i32,
+    pub profile: String,
+}
+
+impl Default for StatsOptions {
+    fn default() -> Self {
+        Self {
+            enable: false,
+            detail: true,
+            retention_days: 30,
+            tz_offset: 0,
+            profile: String::new(),
+        }
+    }
+}
+
+struct Cursor {
+    saved: Bytes,
+    profile: String,
+}
+
+#[derive(Default)]
+pub struct TrafficRecorder {
+    home: Option<Arc<HomeDir>>,
+    days: BTreeMap<String, Day>,
+    cursors: HashMap<u64, Cursor>,
+    options: StatsOptions,
+    running: bool,
+    since: Option<OffsetDateTime>,
+    dirty: bool,
+    pub screen_off: bool,
+    pub suspended: bool,
+}
+
+fn date_key(day: Date) -> String {
+    day.format(DATE).expect("a calendar date can be formatted")
+}
+
+fn rank(items: &BTreeMap<String, Item>, by_hits: bool) -> Vec<(&String, &Item)> {
+    let mut sorted: Vec<_> = items.iter().collect();
+    sorted.sort_unstable_by_key(|(name, item)| {
+        (
+            std::cmp::Reverse(if by_hits {
+                item.hits
+            } else {
+                item.bytes.total()
+            }),
+            *name,
+        )
+    });
+    sorted
+}
+
+impl TrafficRecorder {
+    pub fn load(&mut self, home: Arc<HomeDir>) {
+        if self
+            .home
+            .as_ref()
+            .is_some_and(|old| old.root() == home.root())
+        {
+            return;
+        }
+        self.days.clear();
+        self.home = Some(home);
+        self.dirty = false;
+    }
+
+    fn local(&self, now: OffsetDateTime) -> OffsetDateTime {
+        let offset = UtcOffset::from_whole_seconds(self.options.tz_offset.clamp(-840, 840) * 60)
+            .unwrap_or(UtcOffset::UTC);
+        now.to_offset(offset)
+    }
+
+    fn read_days(&self) -> BTreeMap<String, Day> {
+        self.home
+            .as_ref()
+            .and_then(|home| home.read(FILE).ok())
+            .and_then(|data| serde_json::from_slice(&data).ok())
+            .unwrap_or_default()
+    }
+
+    fn daily(&mut self, day: Date) -> &mut Day {
+        self.dirty = true;
+        let key = date_key(day);
+        if !self.days.contains_key(&key) {
+            let persisted = self.read_days().remove(&key).unwrap_or_default();
+            self.days.insert(key.clone(), persisted);
+        }
+        self.days.get_mut(&key).expect("the day was just inserted")
+    }
+
+    fn settle(&mut self, now: OffsetDateTime) {
+        let Some(start) = self.since else { return };
+        if now <= start {
+            return;
+        }
+        // Retention limits catch-up after a long sleep.
+        let end = self.local(now);
+        let mut start = self
+            .local(start)
+            .max(end - time::Duration::days(i64::from(self.options.retention_days)));
+        self.since = Some(now);
+        while start < end {
+            let midnight = start
+                .date()
+                .next_day()
+                .expect("current date has a successor")
+                .midnight()
+                .assume_offset(start.offset());
+            let until = midnight.min(end);
+            self.daily(start.date()).running_ms += (until - start).whole_milliseconds() as u64;
+            start = until;
+        }
+    }
+
+    pub fn running(&mut self, running: bool) {
+        let now = OffsetDateTime::now_utc();
+        self.settle(now);
+        self.running = running;
+        self.since = (running && self.options.enable).then_some(now);
+        if !running {
+            self.save();
+        }
+    }
+
+    pub fn configure(&mut self, options: StatsOptions, records: &[Arc<ConnRecord>]) {
+        let now = OffsetDateTime::now_utc();
+        self.settle(now);
+        self.sample(records, now);
+        let enable_changed = self.options.enable != options.enable;
+        self.dirty |= self.options.retention_days != options.retention_days;
+        self.options = options;
+        self.since = (self.running && self.options.enable).then_some(now);
+        if enable_changed {
+            self.cursors.clear();
+            if self.options.enable {
+                for record in records {
+                    self.cursors.insert(
+                        record.seq,
+                        Cursor {
+                            saved: Bytes::read(record),
+                            profile: self.options.profile.clone(),
+                        },
+                    );
+                }
+            }
+        }
+        self.prune(now);
+        self.save();
+    }
+
+    fn rule(record: &ConnRecord) -> String {
+        if record.rule_payload.is_empty() {
+            record.rule.to_string()
+        } else {
+            format!("{},{}", record.rule, record.rule_payload)
+        }
+    }
+
+    pub fn opened(&mut self, record: &ConnRecord) {
+        if !self.options.enable {
+            return;
+        }
+        if self.cursors.contains_key(&record.seq) {
+            return;
+        }
+        self.cursors.insert(
+            record.seq,
+            Cursor {
+                saved: Bytes::default(),
+                profile: self.options.profile.clone(),
+            },
+        );
+        if self.options.detail && !record.rule.is_empty() {
+            let now = self.local(OffsetDateTime::now_utc());
+            let day = self.daily(now.date());
+            day.rule_hits += 1;
+            let rules = &mut day.detail[4];
+            rules.entry(Self::rule(record)).or_default().hits += 1;
+            trim_items(rules, 100, true);
+        }
+    }
+
+    fn record(&mut self, record: &ConnRecord, now: OffsetDateTime) {
+        let Some(cursor) = self.cursors.get_mut(&record.seq) else {
+            return;
+        };
+        let current = Bytes::read(record);
+        let delta = current.since(cursor.saved);
+        cursor.saved = current;
+        if delta.total() == 0 {
+            return;
+        }
+        let profile = cursor.profile.clone();
+        let now = self.local(now);
+        let detail = self.options.detail;
+        let day = self.daily(now.date());
+        day.total.add(delta);
+        if !record.direct {
+            day.proxy.add(delta);
+        }
+        day.hours[usize::from(now.hour())].add(delta);
+        if !detail {
+            return;
+        }
+
+        let mut host = record.meta.host.to_string();
+        if host.is_empty() {
+            host = record.meta.sniff_host.to_string();
+        }
+        if host.is_empty() {
+            host = record
+                .meta
+                .dst_ip
+                .map(|ip| ip.to_string())
+                .unwrap_or_default();
+        }
+        let host = host.trim().trim_end_matches('.').to_ascii_lowercase();
+        let domain = if host.parse::<std::net::IpAddr>().is_ok() {
+            host.as_str()
+        } else {
+            psl::domain_str(&host).unwrap_or(&host)
+        };
+        let exit = record.chains.first().map_or("", |name| name.as_ref());
+        let rule = Self::rule(record);
+        let names = [domain, &record.meta.process, exit, &profile, &rule];
+        for (index, name) in names.into_iter().enumerate() {
+            if name.is_empty() {
+                continue;
+            }
+            let items = &mut day.detail[index];
+            let item = items.entry(name.to_owned()).or_default();
+            item.bytes.add(delta);
+            if index == 0 && name != host {
+                item.subs.entry(host.clone()).or_default().add(delta);
+                if item.subs.len() > 25 {
+                    let mut list: Vec<_> = item.subs.iter().collect();
+                    list.sort_unstable_by_key(|(_, bytes)| bytes.total());
+                    let to_remove: Vec<_> = list
+                        .into_iter()
+                        .take(item.subs.len() - 20)
+                        .map(|(key, _)| key.clone())
+                        .collect();
+                    for key in to_remove {
+                        item.subs.remove(&key);
+                    }
+                }
+            }
+            if index == 1 {
+                item.path.clone_from(&record.meta.process_path);
+            }
+            trim_items(items, [200, 100, 100, 50, 100][index], index == 4);
+        }
+    }
+
+    pub fn closed(&mut self, record: &ConnRecord) {
+        self.record(record, OffsetDateTime::now_utc());
+        self.cursors.remove(&record.seq);
+    }
+
+    fn sample(&mut self, records: &[Arc<ConnRecord>], now: OffsetDateTime) {
+        if self.options.enable {
+            for record in records {
+                self.record(record, now);
+            }
+        }
+    }
+
+    fn cutoff(&self, now: OffsetDateTime) -> String {
+        date_key(
+            self.local(now).date()
+                - time::Duration::days(i64::from(self.options.retention_days.saturating_sub(1))),
+        )
+    }
+
+    fn prune(&mut self, now: OffsetDateTime) {
+        let cutoff = self.cutoff(now);
+        let previous = self.days.len();
+        self.days.retain(|key, _| key >= &cutoff);
+        self.dirty |= previous != self.days.len();
+    }
+
+    fn save(&mut self) {
+        if !self.dirty {
+            return;
+        }
+        let result = self.home.as_ref().map(|home| {
+            let mut days = self.read_days();
+            let cutoff = self.cutoff(OffsetDateTime::now_utc());
+            days.retain(|key, _| key >= &cutoff && !self.days.contains_key(key));
+            let days: BTreeMap<_, _> = days.iter().chain(self.days.iter()).collect();
+            let data = serde_json::to_vec(&days)?;
+            home.write_private(FILE, &data)?;
+            Ok::<_, std::io::Error>(())
+        });
+        match result {
+            Some(Ok(())) => {
+                self.dirty = false;
+                let current = date_key(self.local(OffsetDateTime::now_utc()).date());
+                self.days.retain(|key, _| key == &current);
+            }
+            Some(Err(error)) => tracing::warn!("traffic stats save failed: {error}"),
+            None => {}
+        }
+    }
+
+    pub fn interval(&self) -> Option<Duration> {
+        (self.options.enable && !self.suspended && self.running)
+            .then(|| Duration::from_secs(if self.screen_off { 900 } else { 300 }))
+    }
+
+    pub fn checkpoint(&mut self, records: &[Arc<ConnRecord>]) {
+        let now = OffsetDateTime::now_utc();
+        self.settle(now);
+        self.sample(records, now);
+        self.prune(now);
+        self.save();
+    }
+
+    pub fn clear(&mut self, records: &[Arc<ConnRecord>]) -> std::io::Result<()> {
+        if let Some(home) = &self.home {
+            match home.remove_file(FILE) {
+                Ok(()) => {}
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error),
+            }
+        }
+        self.days.clear();
+        self.since = (self.running && self.options.enable).then(OffsetDateTime::now_utc);
+        self.dirty = false;
+        for record in records {
+            if let Some(cursor) = self.cursors.get_mut(&record.seq) {
+                cursor.saved = Bytes::read(record);
+            }
+        }
+        Ok(())
+    }
+
+    pub fn query(
+        &mut self,
+        start: Date,
+        end: Date,
+        top: usize,
+        records: &[Arc<ConnRecord>],
+    ) -> Value {
+        self.checkpoint(records);
+        let mut persisted = self.read_days();
+        let cutoff = self.cutoff(OffsetDateTime::now_utc());
+        persisted.retain(|key, _| key >= &cutoff);
+        let mut answer = Day::default();
+        let mut series = Vec::new();
+        let mut date = start;
+        while date <= end {
+            let key = date_key(date);
+            let day = self.days.get(&key).or_else(|| persisted.get(&key));
+            if let Some(day) = day {
+                answer.running_ms += day.running_ms;
+                answer.rule_hits += day.rule_hits;
+                answer.total.add(day.total);
+                answer.proxy.add(day.proxy);
+                for (target, source) in answer.detail.iter_mut().zip(&day.detail) {
+                    for (name, item) in source {
+                        target.entry(name.clone()).or_default().merge(item);
+                    }
+                }
+            }
+            if start == end {
+                for hour in 0..24 {
+                    let bytes = day.map_or(Bytes::default(), |day| day.hours[hour]);
+                    series.push(json!({"label":hour.to_string(),"up":bytes.up,"down":bytes.down}));
+                }
+            } else {
+                let bytes = day.map_or(Bytes::default(), |day| day.total);
+                series.push(json!({"label":key,"up":bytes.up,"down":bytes.down}));
+            }
+            let Some(next) = date.next_day() else { break };
+            date = next;
+        }
+
+        let mut output = json!({
+            "up": answer.total.up, "down": answer.total.down,
+            "proxy-up": answer.proxy.up, "proxy-down": answer.proxy.down,
+            "running-seconds": answer.running_ms / 1000, "series": series,
+            "rule-hits": answer.rule_hits,
+            "since": self.days.keys().next().into_iter().chain(persisted.keys().next()).min()
+                .map(String::as_str).unwrap_or_default(),
+        });
+        for (index, name) in DIMENSIONS.into_iter().enumerate() {
+            output[name] = Value::Array(
+                rank(&answer.detail[index], index == 4)
+                    .into_iter()
+                    .take(top)
+                    .map(|(name, item)| item.to_json(name))
+                    .collect(),
+            );
+        }
+        output
+    }
+}
+
+fn trim_items(items: &mut BTreeMap<String, Item>, max: usize, by_hits: bool) {
+    if items.len() > max + max / 4 {
+        let remove: Vec<_> = rank(items, by_hits)
+            .into_iter()
+            .skip(max)
+            .map(|(name, _)| name.clone())
+            .collect();
+        for name in remove {
+            items.remove(&name);
+        }
+    }
+}
