diff --git a/crates/api/src/control/customization.rs b/crates/api/src/control/customization.rs
new file mode 100644
index 0000000..c44b5da
--- /dev/null
+++ b/crates/api/src/control/customization.rs
@@ -0,0 +1,277 @@
+use std::collections::BTreeMap;
+use std::net::IpAddr;
+
+use concord_proto::{ApiError, types::*};
+use serde_json::{Value, json};
+
+use super::Control;
+
+const CACHE_FILE: &str = "ip_cache_rust.json";
+const CACHE_TTL_SECONDS: i64 = 30 * 24 * 60 * 60;
+const CACHE_LIMIT: usize = 1024;
+
+fn cache_key(ip: &str, source: Option<&str>) -> Result<String, ApiError> {
+    let address = ip
+        .parse::<IpAddr>()
+        .map_err(|_| ApiError::invalid_field("ip", "invalid IP address"))?;
+    let source = match source {
+        None | Some("scamalytics") => "scamalytics",
+        Some("iplocate") => "iplocate",
+        _ => return Err(ApiError::invalid_field("source", "unknown IP data source")),
+    };
+    Ok(format!("{source}/{address}"))
+}
+
+fn cache_time(entry: &Value) -> i64 {
+    entry["saved"].as_i64().unwrap_or_default()
+}
+
+impl Control {
+    pub(super) async fn traffic_stats_configure(
+        &self,
+        params: TrafficStatsConfig,
+    ) -> Result<Empty, ApiError> {
+        self.require_initialized()?;
+        self.engine.configure_traffic_stats(
+            concord_engine::StatsOptions {
+                enable: params.enable,
+                detail: params.detail,
+                retention_days: params.retention_days.clamp(7, 30),
+                tz_offset: params.tz_offset,
+                profile: params.profile,
+            },
+            params.screen_on,
+            params.suspended,
+        );
+        Ok(Empty {})
+    }
+
+    pub(super) async fn traffic_stats_get(
+        &self,
+        params: TrafficStatsQuery,
+    ) -> Result<Json, ApiError> {
+        self.require_initialized()?;
+        let format = time::macros::format_description!("[year]-[month]-[day]");
+        let parse = |key, date: &str| {
+            time::Date::parse(date, format)
+                .map_err(|err| ApiError::invalid_field(key, err.to_string()))
+        };
+        let start = parse("start", &params.start)?;
+        let end = parse("end", &params.end)?;
+        if end < start || (end - start).whole_days() > 399 {
+            return Err(ApiError::invalid_field(
+                "end",
+                "date range must contain 1 to 400 days",
+            ));
+        }
+        let top = if params.top == 0 {
+            50
+        } else {
+            params.top.min(200)
+        };
+        Ok(self.engine.query_traffic_stats(start, end, top))
+    }
+
+    pub(super) async fn traffic_stats_clear(&self, _params: Empty) -> Result<Empty, ApiError> {
+        self.require_initialized()?;
+        self.engine
+            .clear_traffic_stats()
+            .map_err(|err| ApiError::internal(err.to_string()))?;
+        Ok(Empty {})
+    }
+
+    pub(super) async fn ip_country(&self, params: IpAddress) -> Result<String, ApiError> {
+        self.require_initialized()?;
+        Ok(params
+            .ip
+            .parse()
+            .map_or_else(|_| String::new(), |ip| self.engine.ip_country(ip)))
+    }
+
+    pub(super) async fn ip_cache_get(&self, params: IpCacheGet) -> Result<Json, ApiError> {
+        let key = cache_key(&params.ip, params.source.as_deref())?;
+        let Some(home) = self.engine.home() else {
+            return Ok(Value::Null);
+        };
+        let _guard = self.ip_cache_lock.lock().await;
+        let now = time::OffsetDateTime::now_utc().unix_timestamp();
+        let entries: BTreeMap<String, Value> = home
+            .read(CACHE_FILE)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+            .unwrap_or_default();
+        Ok(entries
+            .get(&key)
+            .filter(|entry| (now - CACHE_TTL_SECONDS..=now).contains(&cache_time(entry)))
+            .map_or(Value::Null, |entry| entry["data"].clone()))
+    }
+
+    pub(super) async fn ip_cache_set(&self, params: IpCacheSet) -> Result<Empty, ApiError> {
+        let key = cache_key(&params.ip, params.source.as_deref())?;
+        if !params.data.is_object() || params.data.to_string().len() > 32 * 1024 {
+            return Err(ApiError::invalid_field("data", "invalid cache record"));
+        }
+        self.require_initialized()?;
+        let home = self
+            .engine
+            .home()
+            .ok_or_else(|| ApiError::internal("missing core home"))?;
+        let _guard = self.ip_cache_lock.lock().await;
+        let now = time::OffsetDateTime::now_utc().unix_timestamp();
+        let mut entries: BTreeMap<String, Value> = home
+            .read(CACHE_FILE)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+            .unwrap_or_default();
+        entries.retain(|_, entry| (now - CACHE_TTL_SECONDS..=now).contains(&cache_time(entry)));
+        entries.insert(key, json!({"saved": now, "data": params.data}));
+        let excess = entries.len().saturating_sub(CACHE_LIMIT);
+        if excess != 0 {
+            let mut oldest: Vec<_> = entries
+                .iter()
+                .map(|(key, entry)| (cache_time(entry), key.clone()))
+                .collect();
+            oldest.sort_unstable();
+            for (_, key) in oldest.into_iter().take(excess) {
+                entries.remove(&key);
+            }
+        }
+        let bytes =
+            serde_json::to_vec(&entries).map_err(|err| ApiError::internal(err.to_string()))?;
+        home.write_private(CACHE_FILE, &bytes)
+            .map_err(|err| ApiError::internal(err.to_string()))?;
+        Ok(Empty {})
+    }
+}
+
+use concord_common::sync::lock;
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+struct SpeedJob {
+    id: String,
+    cancel: CancellationToken,
+    state: Arc<Mutex<Value>>,
+}
+
+#[derive(Default)]
+pub(super) struct SpeedTests(VecDeque<SpeedJob>);
+
+impl SpeedTests {
+    pub(super) fn cancel_all(&self) {
+        for job in &self.0 {
+            job.cancel.cancel();
+        }
+    }
+
+    fn add(&mut self, id: String, initial: Value, replace: bool) -> SpeedJob {
+        if replace {
+            self.cancel_all();
+        }
+        self.0.retain(|job| {
+            if job.id != id {
+                return true;
+            }
+            job.cancel.cancel();
+            false
+        });
+        while self.0.len() >= 8 {
+            if let Some(oldest) = self.0.pop_front() {
+                oldest.cancel.cancel();
+            }
+        }
+        let job = SpeedJob {
+            id,
+            state: Arc::new(Mutex::new(initial)),
+            cancel: CancellationToken::new(),
+        };
+        self.0.push_back(job.clone());
+        job
+    }
+}
+
+fn setup_speed_test(params: &SpeedTestParams) -> Result<Value, ApiError> {
+    if params.id.is_empty() || params.id.len() > 128 {
+        return Err(ApiError::invalid_field(
+            "id",
+            "missing or oversized speed test id",
+        ));
+    }
+    if !matches!(params.protocol.as_str(), "h1" | "h2" | "h3") {
+        return Err(ApiError::invalid_field(
+            "protocol",
+            "expected h1, h2, or h3",
+        ));
+    }
+    Ok(json!({
+        "id": params.id, "phase": "connecting", "provider": "speedtest",
+        "protocol": params.protocol, "streams": params.streams.clamp(1, 16),
+        "duration": params.duration.clamp(5, 20),
+    }))
+}
+
+impl Control {
+    pub(super) async fn speed_test_start(&self, params: SpeedTestParams) -> Result<Json, ApiError> {
+        self.require_configured()?;
+        let state = setup_speed_test(&params)?;
+        let job = lock(&self.speed_tests).add(params.id.clone(), state.clone(), true);
+        let prober = self.engine.speed_prober().clone();
+        let params =
+            serde_json::to_value(params).map_err(|err| ApiError::internal(err.to_string()))?;
+        tokio::spawn(async move {
+            prober
+                .run_speed_test(params, job.state, job.cancel, false)
+                .await;
+        });
+        Ok(state)
+    }
+
+    pub(super) async fn speed_test_probe(&self, params: SpeedTestParams) -> Result<Json, ApiError> {
+        self.require_configured()?;
+        let state = setup_speed_test(&params)?;
+        let job = lock(&self.speed_tests).add(params.id.clone(), state, false);
+        let params =
+            serde_json::to_value(params).map_err(|err| ApiError::internal(err.to_string()))?;
+        self.engine
+            .speed_prober()
+            .run_speed_test(params, job.state.clone(), job.cancel, true)
+            .await;
+        let result = lock(&job.state).clone();
+        Ok(result)
+    }
+
+    pub(super) async fn speed_test_status(&self, params: SpeedTestId) -> Result<Json, ApiError> {
+        lock(&self.speed_tests)
+            .0
+            .iter()
+            .find(|job| job.id == params.id)
+            .map(|job| lock(&job.state).clone())
+            .ok_or_else(|| ApiError::invalid_field("id", "unknown speed test"))
+    }
+
+    pub(super) async fn speed_test_cancel(&self, params: SpeedTestId) -> Result<Empty, ApiError> {
+        if let Some(job) = lock(&self.speed_tests)
+            .0
+            .iter()
+            .find(|job| job.id == params.id)
+        {
+            job.cancel.cancel();
+        }
+        Ok(Empty {})
+    }
+
+    pub(super) async fn speed_test_servers(
+        &self,
+        params: SpeedTestServerQuery,
+    ) -> Result<Json, ApiError> {
+        self.require_configured()?;
+        let job = lock(&self.speed_tests).add(params.id, Value::Null, false);
+        tokio::select! {
+            _ = job.cancel.cancelled() => Ok(json!([])),
+            result = self.engine.speed_prober().speed_servers(&params.proxy, &params.search) =>
+                result.map(Value::Array).map_err(|err| ApiError::internal(err.to_string())),
+        }
+    }
+}
