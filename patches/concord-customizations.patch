diff --git a/crates/engine/src/probe/speed_test.rs b/crates/engine/src/probe/speed_test.rs
new file mode 100644
index 0000000..e7b0748
--- /dev/null
+++ b/crates/engine/src/probe/speed_test.rs
@@ -0,0 +1,618 @@
+use std::convert::Infallible;
+use std::io;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use bytes::{Buf, Bytes};
+use concord_common::{Address, BoxStream, sync::lock};
+use concord_tls::{TlsConnector, TlsOptions};
+use futures_util::{StreamExt, stream::FuturesUnordered};
+use http::{Method, Request, StatusCode, header};
+use http_body_util::{BodyExt, Empty, StreamBody, combinators::BoxBody};
+use hyper::body::Frame;
+use hyper::client::conn::{http1, http2};
+use hyper_util::rt::{TokioExecutor, TokioIo};
+use serde_json::{Value, json};
+use tokio::time::{Instant, timeout};
+use tokio_util::sync::CancellationToken;
+use url::{Position, Url};
+
+use super::{ProbeEnv, Prober};
+
+const DIRECTORY: &str =
+    "https://www.speedtest.net/api/js/servers?engine=js&limit=10&https_functional=true";
+const BLOCK: usize = 64 * 1024;
+const TRANSFER: usize = 25_000_000;
+
+type RequestBody = BoxBody<Bytes, Infallible>;
+
+enum Sender {
+    H1(http1::SendRequest<RequestBody>),
+    H2(http2::SendRequest<RequestBody>),
+    H3(
+        h3::client::SendRequest<h3_quinn::OpenStreams, Bytes>,
+        quinn::Endpoint,
+        quinn::Connection,
+    ),
+}
+
+struct Session {
+    sender: Sender,
+    base: Url,
+    chains: Vec<String>,
+    lifetime: CancellationToken,
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        self.lifetime.cancel();
+        if let Sender::H3(_, endpoint, connection) = &self.sender {
+            connection.close(0u32.into(), b"speed test complete");
+            endpoint.close(0u32.into(), b"speed test complete");
+        }
+    }
+}
+
+fn io_error(error: impl std::fmt::Display) -> io::Error {
+    io::Error::other(error.to_string())
+}
+
+impl Session {
+    async fn connect(
+        env: &dyn ProbeEnv,
+        url: Url,
+        proxy: &str,
+        protocol: &str,
+    ) -> io::Result<Self> {
+        let host = url
+            .host_str()
+            .ok_or_else(|| io_error("missing host"))?
+            .trim_matches(['[', ']']);
+        let address = Address::new(host, url.port_or_known_default().unwrap_or(443));
+        let pin = (!proxy.is_empty()).then_some(proxy);
+        let lifetime = CancellationToken::new();
+        let driver = lifetime.clone();
+        let (sender, chains) = if protocol == "h3" {
+            let (socket, peer, chains) = env.speed_udp(&address, pin).await?;
+            let mut endpoint = quinn::Endpoint::new_with_abstract_socket(
+                quinn::EndpointConfig::default(),
+                None,
+                socket,
+                Arc::new(quinn::TokioRuntime),
+            )?;
+            let tls = concord_tls::quic_client_config(&TlsOptions::default(), env.trust(), &["h3"])
+                .map_err(io_error)?;
+            endpoint.set_default_client_config(quinn::ClientConfig::new(Arc::new(
+                quinn::crypto::rustls::QuicClientConfig::try_from(tls).map_err(io_error)?,
+            )));
+            let connection = endpoint
+                .connect(peer, host)
+                .map_err(io_error)?
+                .await
+                .map_err(io_error)?;
+            let (mut connection_driver, requests) =
+                h3::client::new(h3_quinn::Connection::new(connection.clone()))
+                    .await
+                    .map_err(io_error)?;
+            tokio::spawn(async move {
+                tokio::select! { _ = connection_driver.wait_idle() => {}, _ = driver.cancelled() => {} }
+            });
+            (Sender::H3(requests, endpoint, connection), chains)
+        } else {
+            let dialed = env.dial(&address, pin).await?;
+            let tls = TlsConnector::new(
+                TlsOptions {
+                    alpn: vec![if protocol == "h2" { "h2" } else { "http/1.1" }.to_owned()],
+                    ..TlsOptions::default()
+                },
+                env.trust(),
+            )
+            .map_err(io_error)?;
+            let stream = tls.connect(dialed.stream, host).await?;
+            let io: BoxStream = Box::new(stream);
+            let sender = if protocol == "h2" {
+                let (sender, connection) = http2::handshake(TokioExecutor::new(), TokioIo::new(io))
+                    .await
+                    .map_err(io_error)?;
+                tokio::spawn(async move {
+                    tokio::select! { _ = connection => {}, _ = driver.cancelled() => {} }
+                });
+                Sender::H2(sender)
+            } else {
+                let (sender, connection) =
+                    http1::handshake(TokioIo::new(io)).await.map_err(io_error)?;
+                tokio::spawn(async move {
+                    tokio::select! { _ = connection => {}, _ = driver.cancelled() => {} }
+                });
+                Sender::H1(sender)
+            };
+            (sender, dialed.chains)
+        };
+        Ok(Self {
+            sender,
+            base: url,
+            chains,
+            lifetime,
+        })
+    }
+
+    async fn transfer(
+        &mut self,
+        endpoint: &str,
+        payload: &Bytes,
+        max_body: usize,
+        capture: bool,
+        counter: &Arc<AtomicU64>,
+    ) -> io::Result<(f64, Vec<u8>)> {
+        let url = self.base.join(endpoint).map_err(io_error)?;
+        let target = match self.sender {
+            Sender::H1(_) => &url[Position::BeforePath..Position::AfterQuery],
+            _ => url.as_str(),
+        };
+        let mut builder = Request::builder()
+            .uri(target)
+            .method(if payload.is_empty() {
+                Method::GET
+            } else {
+                Method::POST
+            })
+            .header(header::USER_AGENT, super::BROWSER_USER_AGENT)
+            .header(
+                header::HOST,
+                &url[Position::BeforeHost..Position::AfterPort],
+            )
+            .header(header::ACCEPT_ENCODING, "identity");
+        if !payload.is_empty() {
+            builder = builder
+                .header(header::CONTENT_TYPE, "application/octet-stream")
+                .header(header::CONTENT_LENGTH, payload.len());
+        }
+        let start = Instant::now();
+        let mut data = Vec::new();
+        let mut bytes = 0usize;
+        let latency;
+        if let Sender::H3(sender, _, _) = &mut self.sender {
+            let mut stream = sender
+                .send_request(builder.body(()).map_err(io_error)?)
+                .await
+                .map_err(io_error)?;
+            for chunk in payload.chunks(BLOCK) {
+                stream
+                    .send_data(Bytes::copy_from_slice(chunk))
+                    .await
+                    .map_err(io_error)?;
+                counter.fetch_add(chunk.len() as u64, Ordering::Relaxed);
+            }
+            stream.finish().await.map_err(io_error)?;
+            let response = stream.recv_response().await.map_err(io_error)?;
+            latency = response_latency(start, response.status(), response.headers())?;
+            while let Some(mut chunk) = stream.recv_data().await.map_err(io_error)? {
+                let length = chunk.remaining();
+                let chunk = chunk.copy_to_bytes(length);
+                capture_bytes(
+                    &chunk,
+                    &mut bytes,
+                    &mut data,
+                    max_body,
+                    capture,
+                    counter,
+                    payload.is_empty(),
+                )?;
+            }
+        } else {
+            let body = if payload.is_empty() {
+                Empty::<Bytes>::new().boxed()
+            } else {
+                let progress = counter.clone();
+                let upload = payload.clone();
+                let frames = futures_util::stream::iter((0..upload.len()).step_by(BLOCK).map(
+                    move |offset| {
+                        let chunk = upload.slice(offset..(offset + BLOCK).min(upload.len()));
+                        progress.fetch_add(chunk.len() as u64, Ordering::Relaxed);
+                        Ok::<_, Infallible>(Frame::data(chunk))
+                    },
+                ));
+                BodyExt::boxed(StreamBody::new(frames))
+            };
+            let request = builder.body(body).map_err(io_error)?;
+            let response = match &mut self.sender {
+                Sender::H1(sender) => sender.send_request(request).await,
+                Sender::H2(sender) => sender.send_request(request).await,
+                Sender::H3(..) => unreachable!(),
+            }
+            .map_err(io_error)?;
+            latency = response_latency(start, response.status(), response.headers())?;
+            let mut body = response.into_body();
+            while let Some(frame) = body.frame().await {
+                if let Ok(chunk) = frame.map_err(io_error)?.into_data() {
+                    capture_bytes(
+                        &chunk,
+                        &mut bytes,
+                        &mut data,
+                        max_body,
+                        capture,
+                        counter,
+                        payload.is_empty(),
+                    )?;
+                }
+            }
+        }
+        Ok((latency, data))
+    }
+}
+
+fn response_latency(
+    start: Instant,
+    status: StatusCode,
+    headers: &http::HeaderMap,
+) -> io::Result<f64> {
+    if !status.is_success() {
+        return Err(io_error(format!("HTTP {status}")));
+    }
+    let elapsed = start.elapsed().as_secs_f64() * 1000.0;
+    let processing = headers
+        .get("server-timing")
+        .and_then(|v| v.to_str().ok())
+        .and_then(|value| {
+            value
+                .split(';')
+                .find_map(|part| part.trim().strip_prefix("dur="))
+        })
+        .and_then(|value| value.parse::<f64>().ok())
+        .unwrap_or_default();
+    Ok(if processing > 0.0 && processing < elapsed {
+        elapsed - processing
+    } else {
+        elapsed
+    })
+}
+
+fn capture_bytes(
+    chunk: &[u8],
+    bytes: &mut usize,
+    body: &mut Vec<u8>,
+    max: usize,
+    capture: bool,
+    counter: &AtomicU64,
+    count: bool,
+) -> io::Result<()> {
+    *bytes += chunk.len();
+    if *bytes > max {
+        return Err(io_error("response exceeds speed test limit"));
+    }
+    if count {
+        counter.fetch_add(chunk.len() as u64, Ordering::Relaxed);
+    }
+    if capture {
+        body.extend_from_slice(chunk);
+    }
+    Ok(())
+}
+
+fn server_url(server: &Value) -> Option<Url> {
+    let host = server["host"].as_str()?;
+    let url = Url::parse(&format!("https://{host}/")).ok()?;
+    (url.username().is_empty()
+        && url.password().is_none()
+        && url.path() == "/"
+        && url.query().is_none()
+        && url.fragment().is_none())
+    .then_some(url)
+}
+
+async fn latency_probe(
+    env: &dyn ProbeEnv,
+    base: Url,
+    proxy: &str,
+    protocol: &str,
+) -> io::Result<(Session, f64)> {
+    timeout(Duration::from_secs(4), async {
+        let mut session = Session::connect(env, base, proxy, protocol).await?;
+        let (latency, _) = session
+            .transfer(
+                "/latency.txt",
+                &Bytes::new(),
+                32 * 1024,
+                false,
+                &Arc::new(AtomicU64::new(0)),
+            )
+            .await?;
+        Ok((session, latency))
+    })
+    .await?
+}
+
+impl Prober {
+    pub async fn speed_servers(&self, proxy: &str, search: &str) -> io::Result<Vec<Value>> {
+        let mut url = Url::parse(DIRECTORY).expect("fixed Speedtest directory URL");
+        if !search.trim().is_empty() {
+            url.query_pairs_mut().append_pair("search", search.trim());
+        }
+        let path = url[Position::BeforePath..Position::AfterQuery].to_owned();
+        let mut session = timeout(
+            Duration::from_secs(8),
+            Session::connect(&*self.env, url, proxy, "h1"),
+        )
+        .await??;
+        let (_, body) = timeout(
+            Duration::from_secs(8),
+            session.transfer(
+                &path,
+                &Bytes::new(),
+                256 * 1024,
+                true,
+                &Arc::new(AtomicU64::new(0)),
+            ),
+        )
+        .await??;
+        let rows: Vec<Value> = serde_json::from_slice(&body)?;
+        let mut probes = FuturesUnordered::new();
+        for row in rows.into_iter().take(10) {
+            if let Some(base) = server_url(&row) {
+                probes.push(async move {
+                    let mut row = row;
+                    let latency = latency_probe(&*self.env, base, proxy, "h1")
+                        .await
+                        .map_or(0.0, |(_, latency)| latency);
+                    row["latency"] = json!(latency);
+                    row
+                });
+            }
+        }
+        let mut result = Vec::new();
+        while let Some(row) = probes.next().await {
+            result.push(row);
+        }
+        result.sort_by(|a, b| {
+            let rank = |row: &Value| {
+                row["latency"]
+                    .as_f64()
+                    .filter(|x| *x > 0.0)
+                    .unwrap_or(f64::INFINITY)
+            };
+            rank(a).total_cmp(&rank(b))
+        });
+        Ok(result)
+    }
+
+    pub async fn run_speed_test(
+        &self,
+        params: Value,
+        state: Arc<Mutex<Value>>,
+        cancel: CancellationToken,
+        probe_only: bool,
+    ) {
+        let run = self.speed_test_inner(&params, &state, probe_only);
+        let error = tokio::select! {
+            biased;
+            _ = cancel.cancelled() => "cancelled",
+            result = timeout(Duration::from_secs(125), run) => match result {
+                Ok(Ok(())) => "",
+                Ok(Err(error)) => {
+                    tracing::debug!("speed test failed: {error}");
+                    if error.kind() == io::ErrorKind::TimedOut { "timeout" } else { "unavailable" }
+                }
+                Err(_) => "timeout",
+            }
+        };
+        let mut state = lock(&state);
+        state["phase"] = json!("done");
+        state["error"] = json!(error);
+    }
+
+    async fn speed_test_inner(
+        &self,
+        params: &Value,
+        state: &Mutex<Value>,
+        probe_only: bool,
+    ) -> io::Result<()> {
+        let proxy = params["proxy"].as_str().unwrap_or_default();
+        if !proxy.is_empty() && !self.env.knows(proxy) {
+            return Err(io_error("unknown outbound"));
+        }
+        let (streams, duration, requested) = {
+            let state = lock(state);
+            (
+                state["streams"].as_u64().unwrap_or(1) as usize,
+                Duration::from_secs(state["duration"].as_u64().unwrap_or(10)),
+                state["protocol"].as_str().unwrap_or("h2").to_owned(),
+            )
+        };
+        let server = if server_url(&params["server"]).is_some() {
+            params["server"].clone()
+        } else {
+            self.speed_servers(proxy, "")
+                .await?
+                .into_iter()
+                .find(|row| row["latency"].as_f64().is_some_and(|ms| ms > 0.0))
+                .ok_or_else(|| io_error("no reachable Speedtest server"))?
+        };
+        let base = server_url(&server).ok_or_else(|| io_error("invalid speed test server"))?;
+        let mut protocol = requested.as_str();
+        let (mut session, first) = loop {
+            match latency_probe(&*self.env, base.clone(), proxy, protocol).await {
+                Ok(result) => break result,
+                Err(_) if protocol == "h3" => protocol = "h2",
+                Err(_) if protocol == "h2" => protocol = "h1",
+                Err(error) => return Err(error),
+            }
+        };
+        let address = Address::new(
+            base.host_str().unwrap_or_default(),
+            base.port_or_known_default().unwrap_or(443),
+        );
+        let (rule, payload) = self
+            .env
+            .speed_rule(&address, (!proxy.is_empty()).then_some(proxy))
+            .await;
+        {
+            let mut state = lock(state);
+            state["server"] = json!({"host":server["host"], "country":server["cc"], "city":server["name"], "sponsor":server["sponsor"]});
+            state["protocol"] = json!(protocol);
+            state["fallback"] = json!(protocol != requested);
+            state["outbound"] =
+                json!({"chains":session.chains, "rule": rule, "rule-payload": payload});
+            state["direct"] = json!(
+                session
+                    .chains
+                    .first()
+                    .is_some_and(|name| name.eq_ignore_ascii_case("direct"))
+            );
+            state["latency"] = json!(first);
+        }
+        if probe_only {
+            return Ok(());
+        }
+        lock(state)["phase"] = json!("latency");
+        let mut samples = vec![first];
+        let counter = Arc::new(AtomicU64::new(0));
+        for n in 1..20 {
+            let latency = timeout(
+                Duration::from_secs(3),
+                session.transfer("/latency.txt", &Bytes::new(), 32 * 1024, false, &counter),
+            )
+            .await;
+            if let Ok(Ok((ms, _))) = latency {
+                samples.push(ms);
+            }
+            lock(state)["progress"] = json!(n as f64 / 20.0);
+        }
+        let median = median_value(samples.clone());
+        let jitter = median_value(
+            samples
+                .windows(2)
+                .map(|pair| (pair[0] - pair[1]).abs())
+                .collect(),
+        );
+        {
+            let mut state = lock(state);
+            state["latency"] = json!(median);
+            state["jitter"] = json!(jitter);
+        }
+        let payload = upload_payload();
+        for (phase, endpoint, body) in [
+            ("download", "/download?size=25000000", Bytes::new()),
+            ("upload", "/upload", payload),
+        ] {
+            {
+                let mut value = lock(state);
+                value["phase"] = json!(phase);
+                value["progress"] = json!(0.0);
+                value["speed"] = json!(0.0);
+            }
+            let mut workers = FuturesUnordered::new();
+            for _ in 0..streams {
+                let counter = counter.clone();
+                let base = base.clone();
+                let body = body.clone();
+                let env = &*self.env;
+                workers.push(async move {
+                    let mut connection = Session::connect(env, base, proxy, protocol).await?;
+                    loop {
+                        connection
+                            .transfer(endpoint, &body, TRANSFER + BLOCK, false, &counter)
+                            .await?;
+                    }
+                    #[allow(unreachable_code)]
+                    Ok::<(), io::Error>(())
+                });
+            }
+            let start = Instant::now();
+            let end = start + duration;
+            let before = counter.load(Ordering::Relaxed);
+            let mut last = before;
+            let mut last_tick = start;
+            let mut rates = Vec::new();
+            let mut loaded = Vec::new();
+            let mut tick = tokio::time::interval(Duration::from_millis(200));
+            let mut ping = Box::pin(loaded_latency_from(
+                &*self.env,
+                base.clone(),
+                proxy,
+                protocol,
+            ));
+            loop {
+                tokio::select! {
+                    _ = tokio::time::sleep_until(end) => break,
+                    Some(result) = workers.next() => { if workers.is_empty() { result?; break; } }
+                    ms = &mut ping => {
+                        if let Some(ms) = ms { loaded.push(ms); }
+                        ping.set(loaded_latency_from(&*self.env, base.clone(), proxy, protocol));
+                    },
+                    _ = tick.tick() => {
+                        let bytes = counter.load(Ordering::Relaxed);
+                        let elapsed = start.elapsed().as_secs_f64();
+                        let now = Instant::now();
+                        let interval = now.duration_since(last_tick).as_secs_f64().max(0.001);
+                        let speed = bytes.saturating_sub(last) as f64 * 8.0 / interval;
+                        last = bytes;
+                        last_tick = now;
+                        if elapsed >= 0.4 { rates.push(speed); }
+                        let mut state = lock(state);
+                        state["progress"] = json!((elapsed / duration.as_secs_f64()).min(1.0));
+                        state["speed"] = json!(speed);
+                        state["bytes"] = json!(bytes);
+                    }
+                }
+            }
+            let measured = counter.load(Ordering::Relaxed).saturating_sub(before);
+            if measured == 0 {
+                return Err(io_error("no speed test data transferred"));
+            }
+            let mut value = lock(state);
+            value[phase] = json!(median_value(rates));
+            value[format!("{phase}-latency")] = json!(median_value(loaded));
+            value["bytes"] = json!(counter.load(Ordering::Relaxed));
+        }
+        let mut value = lock(state);
+        let down = value["download-latency"].as_f64().unwrap_or_default();
+        let up = value["upload-latency"].as_f64().unwrap_or_default();
+        if down > 0.0 && up > 0.0 {
+            value["rpm"] = json!((120_000.0 / (down + up)) as u64);
+        }
+        value["progress"] = json!(1.0);
+        Ok(())
+    }
+}
+
+async fn loaded_latency_from(
+    env: &dyn ProbeEnv,
+    base: Url,
+    proxy: &str,
+    protocol: &str,
+) -> Option<f64> {
+    tokio::time::sleep(Duration::from_millis(400)).await;
+    latency_probe(env, base, proxy, protocol)
+        .await
+        .ok()
+        .map(|(_, ms)| ms)
+}
+
+fn median(values: &mut [f64]) -> f64 {
+    if values.is_empty() {
+        return 0.0;
+    }
+    values.sort_by(f64::total_cmp);
+    let mid = values.len() / 2;
+    if values.len().is_multiple_of(2) {
+        (values[mid - 1] + values[mid]) / 2.0
+    } else {
+        values[mid]
+    }
+}
+
+fn median_value(mut values: Vec<f64>) -> f64 {
+    median(&mut values)
+}
+
+fn upload_payload() -> Bytes {
+    let mut block = vec![0u8; BLOCK];
+    rand::RngCore::fill_bytes(&mut rand::rng(), &mut block);
+    let mut data = Vec::with_capacity(TRANSFER);
+    while data.len() < TRANSFER {
+        let size = (TRANSFER - data.len()).min(BLOCK);
+        data.extend_from_slice(&block[..size]);
+    }
+    Bytes::from(data)
+}
